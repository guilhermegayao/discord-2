# Produção. Não preencha à mão: rode ./setup-env.sh, que cria o deploy/.env
# com segredos aleatórios. Este arquivo só documenta as variáveis.

# Endereço público (o LiveKit fica em livekit.<APP_DOMAIN>)
APP_DOMAIN=seu-nome.duckdns.org

# Imagens publicadas pelo CI
IMAGE_PREFIX=ghcr.io/guilhermegayao/discord-2
IMAGE_TAG=latest

# Banco
POSTGRES_USER=discord2
POSTGRES_DB=discord2
POSTGRES_PASSWORD=gerado-pelo-setup-env

# Auth
JWT_ACCESS_SECRET=gerado-pelo-setup-env

# LiveKit
LIVEKIT_API_KEY=discord2
LIVEKIT_API_SECRET=gerado-pelo-setup-env
# Na VM: true (descobre o IP público). Para testar no próprio PC: false + 127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
