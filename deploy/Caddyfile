# Caddy: HTTPS automático para os dois endereços (o certificado é pedido ao
# Let's Encrypt na primeira visita e renovado sozinho).

# O site e a API no mesmo endereço: sem CORS, e o cookie do refresh token
# (path=/api/auth) funciona igual ao desenvolvimento.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API e tempo real (Socket.IO em /api/socket.io; o Caddy repassa WebSocket sozinho).
	handle /api/* {
		reverse_proxy server:3100
	}

	# Site: arquivos do build; rotas do React caem no index.html.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Sinalização do LiveKit (wss://). A mídia não passa por aqui: vai direto
# para as portas 7881/tcp e 7882/udp da VM.
livekit.{$APP_DOMAIN} {
	reverse_proxy livekit:7880
}
