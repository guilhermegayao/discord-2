// A URL de conexão fica em prisma.config.ts (padrão do Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Sempre em minúsculas (normalizado pelo schema do shared)
  email        String    @unique
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  ownedGuilds  Guild[]
  memberships  Member[]
  messages     Message[]
  dmChannels   ChannelParticipant[]
  invites      Invite[]

  @@map("users")
}

/// Uma linha por refresh token emitido. Tokens da mesma "família" vêm
/// de rotações sucessivas do mesmo login.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 do refresh token. O token em si nunca é salvo.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  /// Preenchido quando o token é rotacionado (usado) ou na revogação/logout.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

/// "Servidor" na interface. No código usamos Guild para não confundir
/// com o servidor backend (é o mesmo nome que o Discord usa na API).
model Guild {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  members   Member[]
  channels  Channel[]
  invites   Invite[]

  @@index([ownerId])
  @@map("guilds")
}

enum MemberRole {
  OWNER
  MEMBER
}

model Member {
  guildId  String     @map("guild_id") @db.Uuid
  guild    Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String     @map("user_id") @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now()) @map("joined_at")

  @@id([guildId, userId])
  /// "Meus servidores" consulta por usuário
  @@index([userId])
  @@map("members")
}

enum ChannelType {
  TEXT
  VOICE
  DM
}

/// Canal de texto de um servidor (TEXT) ou conversa direta entre duas pessoas (DM).
/// Uma DM não tem servidor: quem pode ver são os participantes.
model Channel {
  id           String               @id @default(uuid(7)) @db.Uuid
  guildId      String?              @map("guild_id") @db.Uuid
  guild        Guild?               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name         String               @default("")
  type         ChannelType          @default(TEXT)
  position     Int                  @default(0)
  /// Só em DMs: os dois ids de usuário em ordem, "a:b". O índice único
  /// garante uma única DM entre as mesmas duas pessoas.
  dmKey        String?              @unique @map("dm_key")
  createdAt    DateTime             @default(now()) @map("created_at")
  messages     Message[]
  participants ChannelParticipant[]

  @@index([guildId, position])
  @@map("channels")
}

/// Quem participa de uma DM.
model ChannelParticipant {
  channelId String  @map("channel_id") @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  /// "Minhas DMs" consulta por usuário
  @@index([userId])
  @@map("channel_participants")
}

model Invite {
  /// Código curto e aleatório que vai no link (/invite/<code>)
  code      String    @id
  guildId   String    @map("guild_id") @db.Uuid
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creatorId String    @map("creator_id") @db.Uuid
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  uses      Int       @default(0)
  /// null = não expira
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([guildId])
  @@map("invites")
}

model Message {
  /// UUID v7: ordenado por tempo, serve de cursor para a paginação
  id        String    @id @default(uuid(7)) @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id") @db.Uuid
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  /// Histórico do canal: "as N mais novas antes do id X"
  @@index([channelId, id(sort: Desc)])
  @@map("messages")
}
