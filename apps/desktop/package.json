{
  "name": "@discord-2/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "discord-2 para Windows (Electron)",
  "author": "Guilherme",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && electron .",
    "dist": "tsc -p tsconfig.build.json && npm run native && electron-builder --win --publish never",
    "icon": "node scripts/make-icon.mjs",
    "native": "node-gyp rebuild --directory native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.guilhermegayao.discord2",
    "productName": "discord-2",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*.js",
      "native/build/Release/loopback.node",
      "package.json"
    ],
    "asarUnpack": [
      "native/build/Release/loopback.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "discord-2-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "discord-2"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0",
    "vitest": "^5.0.5"
  }
}
