# Copie este arquivo para .env (cp .env.example .env) e ajuste se precisar.
# Portas fora do padrão para não conflitar com outros serviços da máquina.

# --- Banco (docker-compose) ---
POSTGRES_USER=discord2
POSTGRES_PASSWORD=discord2_dev
POSTGRES_DB=discord2
POSTGRES_PORT=5433

# --- Servidor ---
SERVER_PORT=3100
DATABASE_URL=postgresql://discord2:discord2_dev@localhost:5433/discord2?schema=public

# --- Auth ---
# Segredo que assina os access tokens (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS)
COOKIE_SECURE=false

# --- Web ---
WEB_PORT=5174
