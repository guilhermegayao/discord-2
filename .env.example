# Copie este arquivo para .env (cp .env.example .env) e ajuste se precisar.
# Portas fora do padrão para não conflitar com outros serviços da máquina.

# --- Banco (docker-compose) ---
POSTGRES_USER=discord2
POSTGRES_PASSWORD=discord2_dev
POSTGRES_DB=discord2
POSTGRES_PORT=5433

# --- Servidor ---
SERVER_PORT=3100
DATABASE_URL=postgresql://discord2:discord2_dev@localhost:5433/discord2?schema=public

# --- Web ---
WEB_PORT=5174
